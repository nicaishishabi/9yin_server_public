desc_box_leave_001=<font color="#FFFF00">（右键点击打开）</font>
desc_box_leave_001_1=上面绣着几行俊秀的字迹“一些历练和盘缠，让你继续踏上江湖路”。
desc_box_leave_002=<font color="#FFFF00">（右键点击打开）</font>
desc_box_leave_002_1=暗淡了刀光剑影，远去了江湖的恩怨。
desc_box_leave_003=<font color="#FFFF00">（右键点击打开）</font>
desc_box_leave_003_1=隐世许久，潜行修炼，从而获得了大量修为。
desc_box_leave_005_1=<font color="#FFFF00">（右键点击打开）</font>
desc_box_leave_005_1_1=“十年过，江湖远，壮志收，谁晓此间仍有热血留？我隐约看到了昔日的一位位少侠正迈出步子……”剩下的字迹已经模糊不清，隐约还可以看到“重走江湖”几个字。
desc_box_leave_005_2=<font color="#FFFF00">（右键点击打开）</font>
desc_box_leave_005_2_1=包裹底部绣着几行字“开始想念，那曾经握在手中苍凉的岁月，以及那一片灿烂的江湖，还有那些曾经爱过恨过的人们。”这一定出自某位痴情侠女。
desc_box_leave_006=<font color="#FFFF00">（右键点击打开）</font>
desc_box_leave_006_1=银子不是万能的，但没有银子是万万不能的，带上这些以备不时之需。
desc_box_leave_007=<font color="#FFFF00">（右键点击打开）</font>
desc_box_leave_007_1=“看这外观，定是名门世家才有的。”似乎象征着一些身份。                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                  
desc_lilian_leave_001_0=赠与侠士的大量历练。<br><font color="#FFFF00">（右键点击使用）</font>
desc_money_leave_002_0=少许碎银，以作盘缠之用。<br><font color="#FFFF00">（右键点击打开）</font>
desc_money_leave_001_0=数量不少的碎银，够你花上一阵了<br><font color="#FFFF00">（右键点击打开）</font> 
desc_money_leave_003_0=数量庞大的碎银，够你花上一阵了<br><font color="#FFFF00">（右键点击打开）</font>                                               
desc_reputation_leave_001_0=一些身份的象征，看起来可以在江湖提升不少的地位。<br><font color="#FFFF00">（右键点击打开）</font>
desc_mount_6_leave_001_0=<font color="#66CD00">【右键单击马哨，召唤大宛马】</font><br>大宛马体形好，听话，快速，适于长途行军，在游牧民族的征战中发挥重大作用。<br><font color"#FFC125">不可掉落</font>
desc_vip_leave_001_0=使用道具可以延长江湖名俊期限3天
