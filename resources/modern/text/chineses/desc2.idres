desc_FASHION_SUIT_B025_a=四时岚彩霏琼雪，百道泉流湛玉霜。雅称采芝追绮季，尤宜散发学嵇康。
desc_FASHION_SUIT_G032_a=冰簟银床梦不成，碧天如水夜云轻。

desc_pet_xuelang_gensui_0=<font color="#ff0000">【右键单击，将灵物移入收藏界面】</font><br><font color="#ff0000">注意：加入收藏界面后无法取出，和玩家角色绑定。如果是限时灵物，有效期到后会被自动删除</font><br><font face="Default" color="#008B8B" >灵物无法在江湖世界召唤</font><br>使用后将召唤鸣麟跟随玩家。鸣麟调皮伶俐，与主人不离不弃。灵物被召唤期间玩家打坐每秒恢复5点轻功值

desc_pet_xuelang_gensui_a_0=<font color="#ff0000">【右键单击，将灵物移入收藏界面】</font><br><font color="#ff0000">注意：加入收藏界面后无法取出，和玩家角色绑定。如果是限时灵物，有效期到后会被自动删除</font><br><font face="Default" color="#008B8B" >灵物无法在江湖世界召唤</font><br>使用后将召唤鸣麟跟随玩家。鸣麟调皮伶俐，与主人不离不弃。灵物被召唤期间玩家打坐每秒恢复5点轻功值

desc_box_xiaoxuelang_01=鸣麟调皮伶俐，与主人不离不弃。灵物被召唤期间玩家打坐每秒恢复5点轻功值<br>右击使用，可获得鸣麟宠物
desc_box_xiaoxuelang_01_1=

item_pld001=断剑碎片·壹
desc_item_pld001_0=此碎片为魔剑门冷涵的引魔剑的部位一部分<br><font color="#FFFF00">道具作用：合成完整的引魔剑的一部分</font><br><font color="#FFB428">道具获得途径：攻克魔剑门（597,-260）附近东瀛倭寇有机会获得</font>
item_pld002=断剑碎片·贰
desc_item_pld002_0=此碎片为魔剑门冷涵的引魔剑的部位一部分<br><font color="#FFFF00">道具作用：合成完整的引魔剑的一部分</font><br><font color="#FFB428">道具获得途径：攻克魔剑门（597,-260）附近东瀛倭寇有机会获得</font>
item_pld003=断剑碎片·叁
desc_item_pld003_0=此碎片为魔剑门冷涵的引魔剑的部位一部分<br><font color="#FFFF00">道具作用：合成完整的引魔剑的一部分</font><br><font color="#FFB428">道具获得途径：攻克魔剑门（597,-260）附近东瀛倭寇有机会获得</font>
item_pld004=断剑碎片·四
desc_item_pld004_0=此碎片为魔剑门冷涵的引魔剑的部位一部分<br><font color="#FFFF00">道具作用：合成完整的引魔剑的一部分</font><br><font color="#FFB428">道具获得途径：攻克魔剑门（597,-260）附近东瀛倭寇有机会获得</font>
item_pld005=断剑碎片·伍
desc_item_pld005_0=此碎片为魔剑门冷涵的引魔剑的部位一部分<br><font color="#FFFF00">道具作用：合成完整的引魔剑的一部分</font><br><font color="#FFB428">道具获得途径：攻克魔剑门（597,-260）附近东瀛倭寇有机会获得</font>
item_pld006=玄玉粉
desc_item_pld006_0=重新铸造引魔剑的必备之物，能将断剑五部分完美的融合在一起，使用焕然一新，并且威力倍增<br><font color="#FFFF00">道具作用：使用之后重新铸造引魔剑</font><br><font color="#FFB428">道具获得途径：与魔剑门冷涵对话领取获得</font><br>右键点击可使用
item_pld_001=引魔剑
desc_item_pld_001_0=由五部分断剑与玄玉粉重新铸造而成，全身通体泛红，剑身细长，为魔剑门剑隐冷涵佩剑之用<br><font color="#FFFF00">道具作用：上交至魔剑门冷涵处</font><br><font color="#FFB428">道具获得途径：使用玄玉粉与五部分断剑合成</font>

item_pld_010=蓬莱岛藏宝图
tips_itemtype_2619=藏宝图
desc_item_pld_010_0=珍贵的藏宝图，相传为当年徐福至东海蓬莱岛寻长生不老之药路经各地记录之用，记录着蓬莱岛宝藏埋藏的地点，吸引着无数中原人士<br><font color="#FFFF00">道具作用：开启获得任意各种奖励</font><br><font color="#FFB428">道具获得途径：蓬莱岛基础商人处（-151,-502）处兑换获得</font><br>右键点击使用

item_pld_009=藏宝图碎片
desc_item_pld_009_0=珍贵的藏宝图碎片，集齐5份藏宝图碎片即可合成一份完整的藏宝图，相传藏宝图记录着东海蓬莱岛各个宝藏的地点<br><font color="#FFFF00">道具作用：至蓬莱岛基础商人处（-151,-502）处兑换完整的藏宝图</font><br><font color="#FFB428">道具获得途径：蓬莱岛基础行为以及其他特殊行为中获取</font>

key_pld001=银钥
desc_key_pld001_0=蓬莱岛传说的三把钥匙之一，全身泛着闪亮的银光，可以开启蓬莱岛上所有银质匣子，谁也不知道里面到底有什么<br><font color="#FFFF00">道具作用：开启银质匣子</font><br><font color="#FFB428">道具获得途径：在蓬莱岛基础商人处（-151,-502）处购买银钥锤炼制而成</font>

key_pld002=金钥
desc_key_pld002_0=蓬莱岛传说的三把钥匙之一，全身泛着耀眼的金光，可以开启蓬莱岛上所有金质匣子，很大可能就是意外的财宝<br><font color="#FFFF00">道具作用：开启金质匣子</font><br><font color="#FFB428">道具获得途径：在蓬莱岛基础商人处（-151,-502）处购买金钥锤炼制而成</font>

key_pld003=玉钥
desc_key_pld003_0=蓬莱岛传说的三把钥匙之中最贵重的一把，全身泛着异常洁白的亮光，可以开启蓬莱岛上所有玉质匣子，巨大的宝藏在等着你<br><font color="#FFFF00">道具作用：开启黑玉匣子</font><br><font color="#FFB428">道具获得途径：在蓬莱岛基础商人处（-151,-502）处购买玉钥锤炼制而成</font>

pld_kuangshi001=红莹石
desc_pld_kuangshi001_1=蓬莱岛上物产丰富，各类石材遍布全岛，红莹石就是其中之一，虽然质地普通<br><font color="#FFFF00">道具作用：合成蓬莱岛匣子钥匙的基础材料，可去蓬莱岛基础商人（-151,-502）处购买相应的道具合成钥匙</font><br><font color="#FFB428">道具获得途径：采集蓬莱岛上矿石有机会获得</font>
desc_pld_kuangshi001= 

pld_kuangshi002=海蓝石
desc_pld_kuangshi002_1=蓬莱岛上物产丰富，各类石材遍布全岛，海蓝石也是其中之一，质地比起红莹石坚实许多<br><font color="#FFFF00">道具作用：合成蓬莱岛匣子钥匙的基础材料，可去蓬莱岛基础商人（-151,-502）处购买相应的道具合成钥匙</font><br><font color="#FFB428">道具获得途径：采集蓬莱岛上矿石有机会获得</font>
desc_pld_kuangshi002= 

pld_kuangshi003=雪心石
desc_pld_kuangshi003_1=蓬莱岛上物产丰富，各类石材遍布全岛，但雪心石则较少，特别珍贵；质地异常坚硬，全身泛着白洁的光芒<br><font color="#FFFF00">道具作用：合成蓬莱岛匣子金钥的重要材料，可去蓬莱岛基础商人（-151,-502）处购买相应的道具合成钥匙</font><br><font color="#FFB428">道具获得途径：采集蓬莱岛上矿石有机会获得</font>
desc_pld_kuangshi003= 

pld_kuangshi004=焰火石
desc_pld_kuangshi004_1=蓬莱岛上物产丰富，各类石材遍布全岛，焰火石则是最为稀少的，极其珍贵，质地柔软异常，周身被火焰色包围，一般人不敢靠近<br><font color="#FFFF00">道具作用：合成蓬莱岛匣子玉钥的重要材料，可去蓬莱岛基础商人（-151,-502）处购买相应的道具合成钥匙</font><br><font color="#FFB428">道具获得途径：采集蓬莱岛上矿石有机会获得</font>
desc_pld_kuangshi004= 

useitem_pld003=银钥锤
desc_useitem_pld003_0=铸造银钥的必备工具，辅以石材红莹石及海蓝石，方可铸造银钥，银钥可开启蓬莱岛上所有银质匣子<br><font color="#FFFF00">道具作用：铸造银钥的必备工具</font><br><font color="#FFB428">道具获得途径：蓬莱岛基础商人处（-151,-502）购买</font><br>右键点击使用

useitem_pld004=金钥锤
desc_useitem_pld004_0=铸造金钥的必备工具，辅以石材红莹石、海蓝石以及雪心石，方可铸造金钥，金钥可开启蓬莱岛上所有金质匣子<br><font color="#FFFF00">道具作用：铸造金钥的必备工具</font><br><font color="#FFB428">道具获得途径：蓬莱岛基础商人处（-151,-502）购买</font><br>右键点击使用

useitem_pld005=玉钥锤
desc_useitem_pld005_0=铸造玉钥的必备工具，辅以石材红莹石、海蓝石以及焰火石，方可铸造玉钥，玉钥可开启蓬莱岛上所有玉质匣子<br><font color="#FFFF00">道具作用：铸造玉钥的必备工具</font><br><font color="#FFB428">道具获得途径：蓬莱岛基础商人处（-151,-502）购买获得</font><br>右键点击使用

item_pld007=完整的虎皮
desc_item_pld007_0=一张完整的白虎皮，看皮毛应该是白虎身上的<br><font color="#FFFF00">道具作用：智者老人（-205,-343）应该会对此物特别感兴趣</font><br><font color="#FFB428">道具获得途径：攻克（529,-39）（-166,-40）两处白虎获得</font>

item_pld008=魔莲花
desc_item_pld008_0=一朵散发雪白的光芒的白花，可魔剑门的人为什么都称其为魔莲花，其中定有诡异<br><font color="#FFFF00">道具作用：魔剑门冷涵（611,-1）应该会对此物有兴趣</font><br><font color="#FFB428">道具获得途径：魔剑门后山采集获得</font>

item_pld009=村长的书信
desc_item_pld009_0=蓬莱村村长亲笔书信，收件人是清音壁长老黄媛<br><font color="#FFFF00">道具作用：帮助村长将此信交给清音壁长老云梦（-211,-592）</font><br><font color="#FFB428">道具获得途径：蓬莱村村长对话获得</font>

item_pld010=百叶草
desc_item_pld010_0=蓬莱岛上特有的一种药草，有明目静心之作用<br><font color="#FFFF00">道具作用：药材商人（-86,-22）对此颇感兴趣</font><br><font color="#FFB428">道具获得途径：蓬莱岛（-166,-40）位置附近采集获得</font>

item_pld011=百叶草之芯
desc_item_pld011_0=百叶草精华之所在，常常用作非常重要的药引之一，难得一遇<br><font color="#FFFF00">道具作用：药材商人（-86,-22）对此颇感兴趣</font><br><font color="#FFB428">道具获得途径：蓬莱岛（-166,-40）位置附近采集百叶草有机会额外获得</font>

item_pld012=送往侠客岛的引荐信
desc_item_pld012_0=初入东海，蓬莱岛使者为引荐少侠前去侠客岛探索一番，特此书信<br><font color="#FFFF00">道具作用：收件人注明是“侠客岛使者-冷然”</font><br><font color="#FFB428">道具获得途径：初入蓬莱岛，蓬莱岛使者处获得</font>

item_pld013=送往无极岛的引荐信
desc_item_pld013_0=初入东海，蓬莱岛使者为引荐少侠前去无极岛探索一番，特此书信<br><font color="#FFFF00">道具作用：收件人注明是“无极岛使者-冷菁”</font><br><font color="#FFB428">道具获得途径：初入蓬莱岛，蓬莱岛使者处获得</font>

item_pld014=精致的锄型原件
desc_item_pld014_0=一枚精致的锄型原件，质地厚重，外观通体泛光，定非凡物<br><font color="#FFFF00">道具作用：兑换神器“开天神锄”的重要组成部位之一</font><br><font color="#FFB428">道具获得途径：蓬莱洞天秘境中获得</font>

item_pld015=闪亮的锤型原件
desc_item_pld015_0=一枚闪亮的锤型原件，质地坚硬如铁<br><font color="#FFFF00">道具作用：兑换神器“开天神锤”的重要组成部位之一</font><br><font color="#FFB428">道具获得途径：蓬莱洞天秘境中获得</font>

item_pld016=智者老人的书画
desc_item_pld016_0=画中人物栩栩如生，看其如入奇景，妙哉妙哉<br><font color="#FFFF00">道具作用：智者老人（-205,-343）的认可之物</font><br><font color="#FFB428">道具获得途径：正确回答智者老人的所有题目</font>

item_pld017=魔剑门密令
desc_item_pld017_0=此物为魔剑门之重要信物，万万不可落入奸人之手<br><font color="#FFFF00">道具作用：归还于魔剑门长老冷凌厉（688,611），获得赏识</font><br><font color="#FFB428">道具获得途径：攻克魔剑门内应获得</font>

item_pld018=清音壁密令
desc_item_pld018_0=此物为清音壁之重要信物，万万不可落入奸人之手<br><font color="#FFFF00">道具作用：归还于清音壁，获得赏识</font><br><font color="#FFB428">道具获得途径：攻克清音壁内应获得</font>

item_pld019=神月宫密令
desc_item_pld019_0=此物为神月宫之重要信物，万万不可落入奸人之手<br><font color="#FFFF00">道具作用：归还于神月宫，获得赏识</font><br><font color="#FFB428">道具获得途径：攻克神月宫内应获得</font>

item_pld020=生死判密令
desc_item_pld020_0=此物为生死判之重要信物，万万不可落入奸人之手<br><font color="#FFFF00">道具作用：归还于生死判，获得赏识</font><br><font color="#FFB428">道具获得途径：攻克生死判内应获得</font>

item_pld021=蓬莱洞天令牌
desc_item_pld021_0=由老顽童亲手制造，交给蓬莱洞天秘境中的某位故人<br><font color="#FFFF00">道具作用：蓬莱洞天秘境中的某位高人见到此物必定甚是高兴</font><br><font color="#FFB428">道具获得途径：在老顽童处上缴一份完整藏宝图即可获得</font>

sworn_lengpf001=义之石
tips_itemtype_2490=结拜召唤道具
desc_sworn_lengpf001_0=危难时刻，召唤兄弟！<br>同生死，共患难，有福同享，有难同当！<br><font color="#FFFF00">特别注意：道具只限于四大新手村、五大主城、各大宗派以及塞外大漠场景使用</font><br>右键点击使用

menu_xkd_cc_01=我想要挑战屠戮岛主的身份。
title_xkd_1n_cc_01=好吧，祝你好运。
menu_xkd_1n_cc_02=借您吉言。


desc_item_pl_001_0=<font color="#00ff00">武学拓印，收集10本，可以交给离苏或者子车博。</font>
desc_item_pl_002_0=<font color="#00ff00">武学秘籍，可以交给离苏或者季伟善。</font>
desc_item_pl_003_0=<font color="#00ff00">生死判初级弟子证明自己不是叛徒的口供，可以交给莘致国。</font>
desc_item_pl_004_0=<font color="#00ff00">武学残卷，收集10本，步雪需要的东西，可以换取生死判腰牌。</font>
desc_item_pl_005_0=<font color="#00ff00">生死判腰牌，南颜需要的东西。</font>
desc_item_pl_006_0=<font color="#00ff00">生死阁令牌，通过生死阁试炼的凭证，交给紫姣。</font>
desc_item_pl_007_0=<font color="#00ff00">老人被抢的包裹，可以还给蓬莱村的老人。</font>
desc_item_pl_008_0=里面有一些衣物和食物<br><font color="#00ff00">可以施舍给蓬莱村附近的乞丐。</font>
desc_item_pl_009_0=信佛者的书信<br><font color="#00ff00">佛门长老玄海需要的东西，他在蓬莱村附近。</font>
desc_item_pl_010_0=<font color="#00ff00">玄真遗失的佛珠，拿着这串佛珠的还给蓬莱村附近的佛门长老玄真。</font>
desc_item_pl_011_0=馒头可以交给蓬莱村的佛门僧人玄清。
desc_item_pl_012_0=可以用来喂羊<br><font color="#00ff00">可以喂养蓬莱村的羊。</font>
desc_item_pl_013_0=山上的野鸡<br><font color="#00ff00">可以交给蓬莱村的郑大叔。</font>
desc_item_pl_014_0=杀死虎王获得的老虎皮<br><font color="#00ff00">可以交给蓬莱村的叶师傅。</font>
desc_item_pl_015_0=杀死熊王获得的熊胆<br><font color="#00ff00">可以交给蓬莱村的霍师傅。</font>
desc_item_pl_019_0=成功挑战季森后获得的凭证，可以继续挑战宫进。
desc_item_pl_020_0=成功挑战宫进后获得的凭证，可以继续挑战诸葛刚。
desc_item_pl_021_0=成功挑战诸葛刚后获得的凭证，可以前去找袁飞振对话。

system_npc_zp_cc_003_01=上交之后，此道具将会被系统回收，您在本周期内获得的血腥值将会被记录到对应排行榜内。
system_npc_zp_cc_003_02=你好，我要上交屠戮令牌道具。
system_npc_zp_cc_003_03=嗯。拿来吧。
system_npc_zp_cc_003_04=好的，明白了。
system_npc_zp_cc_003_05=<font color="#00ff00">屠戮令牌</font>已经被系统回收，您的血腥值数据将会被记录到排行榜内。
desc_item_pld_gujhxr_0=顾瑀给予的一把染毒的匕首用来突击顾翔的武器。<br><font color="#FFFF00">道具作用：突击顾翔所用道具</font><br><font color="#FFB428">道具获得途径：顾瑀（神秘隐卫）处获得</font>
desc_item_gujmmgx_001_0=与顾晓（学者）对诗所获取的道具，可以在顾晓（学者）处换取东海历练值。<br><font color="#FFFF00">道具作用：兑换东海历练值</font><br><font color="#FFB428">道具获得途径：顾晓（学者）处获得</font>
desc_item_pld_wqg01_0=蓬莱岛山村中仅存的几把完好武器中的一把，蓬莱岛村民所给武器，用于击退登岛作乱倭寇。<br><font color="#FFFF00">道具作用：前往击退倭寇所用道具</font><br><font color="#FFB428">道具获得途径：村民处获得</font>
desc_key_pld_jianke002_0=倭寇登岛后抢占所得物资，岛中村民急需此类物资。将此道具交于古灵（村民）（-210，-492）<br><font color="#FFFF00">道具作用：可交于村民获取奖励</font><br><font color="#FFB428">道具获得途径：击退倭寇获得</font>

desc_item_pldjianke001_0=蓬莱岛上江湖侠士遗留在岛上的断剑，已经不知其来历，但是断剑锋芒依旧。<br><font color="#FFFF00">道具作用：神秘剑客收集道具</font><br><font color="#FFB428">道具获得途径：可在断剑处获得</font>

desc_item_pldjianke002_0=蓬莱岛上江湖侠士遗留在岛上的断剑，已经不知其来历，但是断剑锋芒依旧，已被神秘剑客锻造过的断剑，可用于重铸。<br><font color="#FFFF00">道具作用：重铸断剑所用道具</font><br><font color="#FFB428">道具获得途径：神秘剑客处获得</font>
desc_item_wuzhe_001_0=熊掌，熊身上的一处食材，顾韬正在收集此物。<br><font color="#FFFF00">道具作用：顾韬处换取东海阅历值</font><br><font color="#FFB428">道具获得途径：熊身上掉落</font>
desc_item_wuzhe_002_0=熊胆，熊身上的一处食材亦可作为药材，顾韬正在收集此物。<br><font color="#FFFF00">道具作用：顾韬处换取东海阅历值</font><br><font color="#FFB428">道具获得途径：熊身上掉落</font>
desc_item_wuzhe_003_0=熊肉，熊身上的一处食材，顾韬正在收集此物。<br><font color="#FFFF00">道具作用：顾韬处换取东海阅历值</font><br><font color="#FFB428">道具获得途径：熊身上掉落</font>
desc_item_wuzhe_004_0=熊皮，熊的一身毛皮，可用于保暖，顾韬正在收集此物。<br><font color="#FFFF00">道具作用：顾韬处换取东海阅历值</font><br><font color="#FFB428">道具获得途径：熊身上掉落</font>
desc_item_cike001_0=魔剑门长老身份象征，此令牌为开启秘境的钥匙之一。<br><font color="#FFFF00">道具作用：可用于合成秘境密令</font><br><font color="#FFB428">道具获得途径：谷穗（剑隐）处获得</font>
desc_item_cike002_0=清音壁长老身份象征，此令牌为开启秘境的钥匙之一。<br><font color="#FFFF00">道具作用：可用于合成秘境密令</font><br><font color="#FFB428">道具获得途径：弦惊（阆风五子）处获得</font>
desc_item_cike003_0=神月宫长老身份象征，此令牌为开启秘境的钥匙之一。<br><font color="#FFFF00">道具作用：可用于合成秘境密令</font><br><font color="#FFB428">道具获得途径：月貂（银钩宫卿）处获得</font>
desc_item_cike004_0=生死判长老身份象征，此令牌为开启秘境的钥匙之一。<br><font color="#FFFF00">道具作用：可用于合成秘境密令</font><br><font color="#FFB428">道具获得途径：言铎（生死判司）处获得</font>
desc_item_cike005_0=蓬莱岛秘境密令用于开启秘境的钥匙。<br><font color="#FFFF00">道具作用：进入秘境的钥匙</font><br><font color="#FFB428">道具获得途径：通过熔合四大令牌获得</font>
desc_item_cike006_0=一块神秘的石头，可以将四大令牌熔解，并显现出其中的秘密。<br><font color="#FFFF00">道具作用：熔解四大长老令牌</font><br><font color="#FFB428">道具获得途径：顾鑫(神秘刺客)处获得</font><br>右击可以用
desc_item_pld_005_0=蓬莱岛特有矿产，炼制武器时加入此矿可使武器品质提升。<br><font color="#FFFF00">道具作用：清音壁长老、弟子所需道具</font><br><font color="#FFB428">道具获得途径：神秘匣子处获得</font>
desc_item_pld_004_0=清音壁长老曦香（琼华五娥）所丢铜镜残片，可前往曦香（琼华五娥）处了解情况。<br><font color="#FFFF00">道具作用：曦香（琼华五娥）所需道具</font><br><font color="#FFB428">道具获得途径：神秘匣子处获得</font>
desc_item_pld_008_0=清音壁长老曦香（琼华五娥）所丢铜镜残片，可前往曦香（琼华五娥）处了解情况。<br><font color="#FFFF00">道具作用：曦香（琼华五娥）所需道具</font><br><font color="#FFB428">道具获得途径：凌幕离（修真弟子）处获得</font>
desc_item_pld_002_0=清音壁长老墨离(阆风五子)给飘渺（修真弟子）的信件<br><font color="#FFFF00">道具作用：飘渺（修真弟子）所需道具</font><br><font color="#FFB428">道具获得途径：墨离(阆风五子)处获得</font>
desc_item_pld_007_0=前几日探索<font color="#ffff00">神秘匣子(123,243)</font>时可能将铜镜丢失了，可前往凌幕离（修真弟子）处打探下消息，并且在坐标（157 180）处水罐中有奇异石块能融合破坏的金属<br><font color="#FFFF00">道具作用：找回铜镜所需道具</font><br><font color="#FFB428">道具获得途径：曦香（琼华五娥）处获得</font>
desc_item_pld_006_0=可将金属物融合完整的奇异石头，将铜镜修复。<br><font color="#FFFF00">道具作用：修复铜镜所用道具</font><br><font color="#FFB428">道具获得途径：水罐中获得</font><br>右击可以用
desc_item_pld_011_0=长老所丢铜镜，可给予曦香（琼华五娥）<br><font color="#FFFF00">道具作用：曦香（琼华五娥）丢失道具</font><br><font color="#FFB428">道具获得途径：合成获得</font>
desc_key_pld_bmzy001_0=清音壁长老写信所需要的笔墨纸砚。<br><font color="#FFFF00">道具作用：墨离(阆风五子)所需道具</font><br><font color="#FFB428">道具获得途径：秦溪枫（修真弟子）处获得</font>

desc_item_pld_lzy001_0=神月宫长老紫光的兔子，灵活贪吃，爱吃山上的草类<br><font color="#FFFF00">道具作用：神月宫长老紫光正在寻找，速去将其归还</font><br><font color="#FFB428">道具获得途径：在神月宫后山处使用撒了眩晕药的草将其捕获</font>
desc_item_pld_lzy002_0=神月宫后山的杂草<br><font color="#FFFF00">道具作用：与玉弓门人田颖所制的眩晕药混合后可喂食兔子使其昏迷，乘机抓获</font><br><font color="#FFB428">道具获得途径：在神月宫后山处采集获得</font>
desc_item_pld_lzy003_0=神月宫后山特有的莴苣，是兔子喜爱的食物<br><font color="#FFFF00">道具作用：神月宫长老红袖养的兔子喜欢吃的食物</font><br><font color="#FFB428">道具获得途径：在神月宫后山处采集获得</font>
desc_item_pld_lzy004_0=玉弓门人田颖自制的眩晕药，兔子食用后会短时间昏迷<br><font color="#FFFF00">道具作用：采集神月宫后山杂草后使用便可混合为迷草，喂食兔子使其昏迷，乘机抓获</font><br><font color="#FFB428">道具获得途径：玉弓门人田颖处获得</font>
desc_item_pld_lzy005_0=混合了眩晕药的杂草<br><font color="#FFFF00">道具作用：可使兔子短暂昏迷，将其捕获</font><br><font color="#FFB428">道具获得途径：在神月宫后山采集到杂草后，使用在玉弓门人田颖获得的眩晕药即可获得</font>
desc_item_pld_lzy006_0=神月宫后山特有的莴苣，已被野兔字啃坏<br><font color="#FFFF00">道具作用：神月宫长老红袖的兔子爱吃的莴苣，但已被啃坏，毫无作用</font><br><font color="#FFB428">道具获得途径：在神月宫后山处采集获得</font>
desc_item_pld_lzy007_0=沉甸甸的一包财物<br><font color="#FFFF00">道具作用：字画商陈灿的财物，被蓬莱村中混混狄非强抢而去，从其手中夺回交与陈灿</font><br><font color="#FFB428">道具获得途径：击败狄非后与其对话获得</font>
desc_item_pld_lzy009_0=一支上好的毛笔<br><font color="#FFFF00">道具作用：作画时需要的基础道具</font><br><font color="#FFB428">道具获得途径：通过制笔工具、狼毛、竹子合成获得</font>
desc_item_pld_lzy014_0=精致的小工具<br><font color="#FFFF00">道具作用：可将竹子、狼毛合成狼毫毛笔</font><br><font color="#FFB428">道具获得途径：在字画商处获得</font>
desc_item_pld_lzy015_0=书写工整的手抄本<br><font color="#FFFF00">道具作用：教书先生赵文庭正在收集各类书籍</font><br><font color="#FFB428">道具获得途径：在颜卿完成书法小游戏获得</font>
desc_item_pld_lzy016_0=一张描绘了蓬莱岛港口景色的画卷<br><font color="#FFFF00">道具作用：上交给顾庆证明自己的丹青造诣</font><br><font color="#FFB428">道具获得途径：在顾东完成拼图小游戏获得</font>
desc_item_pld_lzy017_0=一张描绘了神月宫莲池的画卷。<br><font color="#FFFF00">道具作用：上交给顾庆证明自己的丹青造诣</font><br><font color="#FFB428">道具获得途径：在唐雯完成拼图小游戏获得</font>
desc_item_pld_lzy018_0=一张精细的画，描绘了清音壁神树的景色。已有大师风范<br><font color="#FFFF00">道具作用：上交给顾庆证明自己的丹青造诣</font><br><font color="#FFB428">道具获得途径：在欧小曼完成拼图小游戏获得</font>
desc_item_pld_lzy019_0=坚韧的竹子<br><font color="#FFFF00">道具作用：制作狼毫毛笔的材料，拥有狼毛后使用制笔工具制作狼毫毛笔，亦可至神秘渔夫处兑换鱼竿</font><br><font color="#FFB428">道具获得途径：采集青竹获得</font>
desc_item_pld_lzy020_0=一撮灰色的狼毛<br><font color="#FFFF00">道具作用：制作狼毫毛笔的材料，拥有竹子后使用制笔工具制作狼毫毛笔</font><br><font color="#FFB428">道具获得途径：攻克岛中灰狼获得</font>
desc_item_pld_lzy022_0=一片纯金打造的叶子，做工精美，具有收藏价值<br><font color="#FFFF00">道具作用：楚寒玉考验之物，前去收藏家谢狄处出售</font><br><font color="#FFB428">道具获得途径：楚寒玉处接受速度考验获得</font>
desc_item_pld_lzy023_0=一个钱袋，貌似没有几个铜板<br><font color="#FFFF00">道具作用：交给楚寒玉完成其给与的考验</font><br><font color="#FFB428">道具获得途径：超过限定时间将楚寒玉给与的金叶出售给收藏家谢狄即可获得</font>
desc_item_pld_lzy024_0=一个钱袋，装有不少铜钱<br><font color="#FFFF00">道具作用：交给楚寒玉完成其给与的考验</font><br><font color="#FFB428">道具获得途径：在限定时间内将楚寒玉给与的金叶出售给收藏家谢狄即可获得</font>
desc_item_pld_lzy025_0=沉甸甸的一包财物<br><font color="#FFFF00">道具作用：交给楚寒玉完成其给与的任务</font><br><font color="#FFB428">道具获得途径：向蓬莱村中富商钱策施展偷盗技能机会获得</font>
