desc_buff_dfsj_dzt_13_0=<font color="#f9fc00">寒气入体</font><br/>减速、禁轻功、无法回复气血和内力，每次出招自身将受到伤害<br/><font color="#FF3030">点燃煤炭或进入煤炭的火焰范围可以驱散该效果</font>
desc_buff_dfsj_dzt_13_1=
